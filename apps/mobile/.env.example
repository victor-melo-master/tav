# TAV Mobile — variables de entorno
#
# Copia este archivo a .env y ajusta la URL según el entorno.
# El valor se pasa a Flutter con --dart-define (ver abajo).
#
# La API escucha en localhost:3001. Desde el dispositivo/simulador la URL
# cambia según la plataforma:
#
#   iOS Simulator:   http://localhost:3001      (localhost = tu Mac)
#   Android Emulator: http://10.0.2.2:3001      (10.0.2.2 = loopback al host)
#   Dispositivo físico: http://<IP-de-tu-Mac>:3001  (misma red WiFi)
#
# Comandos de ejecución:
#
#   iOS Simulator:
#     flutter run --dart-define=API_BASE_URL=http://localhost:3001
#
#   Android Emulator:
#     flutter run --dart-define=API_BASE_URL=http://10.0.2.2:3001
#
#   Dispositivo físico (misma red WiFi, sustituye la IP):
#     flutter run --dart-define=API_BASE_URL=http://192.168.1.100:3001

API_BASE_URL=http://localhost:3001
