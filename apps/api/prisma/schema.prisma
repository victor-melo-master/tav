generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────── USUARIOS ───────────────────────────────

// MONEDA BASE DEL LIBRO DE DEUDA: GYD (dólar guyanés), en centavos (BigInt).
// El libro tiene una sola moneda por diseño; no se nombran los campos con la
// moneda porque el día que cambie, el nombre mentiría. La multi-moneda vive
// en las cajas (Caja.moneda) y en la conversión de cobros (Cobro.moneda +
// Cobro.tasaAplicada), no en el ledger de deuda.

enum Rol {
  cajero
  cobrador
  admin
  pagador
}

model Usuario {
  id           String    @id @default(uuid())
  rol          Rol
  nombre       String
  email        String    @unique
  telefono     String?
  documento    String?
  passwordHash String
  pinHash      String?
  activo       Boolean   @default(true)
  ultimaVezAt  DateTime? // para la alerta de "sin conectarse hace 3 días"
  creadoAt     DateTime  @default(now())
  creadoPorId  String?

  // Logout real: incrementar tokenVersion invalida todos los tokens emitidos
  // antes del incremento. El JWT lleva la versión con la que se firmó; refresh
  // y loginPin rechazan si no coincide con la del usuario en BD.
  tokenVersion Int @default(0)

  // Bloqueo del PIN: tras 5 fallos consecutivos, pinBloqueadoAt se fija y el
  // usuario debe entrar con contraseña para desbloquear.
  pinIntentos    Int       @default(0)
  pinBloqueadoAt DateTime?

  perfilCajero   PerfilCajero?
  perfilCobrador PerfilCobrador?
  perfilPagador  PerfilPagador?

  @@index([rol, activo])
}

model PerfilCajero {
  usuarioId   String    @id
  usuario     Usuario   @relation(fields: [usuarioId], references: [id])
  limiteCents BigInt // lo fija el admin
  saldoCents  BigInt    @default(0) // CACHE. Solo se escribe dentro de la transacción del movimiento.
  deudaDesde  DateTime? // fecha del cargo más viejo sin saldar → alimenta el eje "días"
  zona        String?
  direccion   String?
  notas       String?

  operaciones  Operacion[]
  cobros       Cobro[]
  movimientos  Movimiento[]
  ampliaciones AmpliacionCredito[]
  atenciones   Atencion[]
  avisos       Aviso[]
  precios      PrecioCajeroServicio[]
}

model PerfilCobrador {
  usuarioId String  @id
  usuario   Usuario @relation(fields: [usuarioId], references: [id])
  zona      String?

  cobros     Cobro[]
  cierres    Cierre[]
  atenciones Atencion[]
}

/// Un pagador por país. Atiende varias monedas (varios corredores) de ese país.
/// Lo crea el admin, igual que cajero y cobrador.
model PerfilPagador {
  usuarioId String  @id
  usuario   Usuario @relation(fields: [usuarioId], references: [id])
  pais      String // código ISO-3 ("VEN", "BRA", ...) — agrupa los corredores que atiende
  notas     String?

  @@index([pais])
}

// ──────────────────── PRECIOS POR CAJERO (Fase 9, nuevo modelo) ────────────────────
//
// El modelo de tasas compuestas (pata base + pata destino + margen) se
// eliminó: el cliente aclaró que cada cajero tiene su propio precio en GYD
// por dólar, por servicio, negociado con él y fijo hasta que el admin lo
// cambie. Ver docs/07-fase-9-multi-corredor.md (modelo corregido).
//
//   deudaGydCents = round_half_up(montoUsdCents × precioGyd) ÷ 100
//
// `precioGyd` es un RATIO (GYD por 1 USD), no un monto: va en Decimal(18,6),
// igual que `tasaAplicada` y `Tasa.valor`. La regla de los centavos aplica al
// dinero que entra al libro (la deuda en GYD, en BigInt); la multiplicación
// se hace en Decimal con ROUND_HALF_UP y el resultado se convierte a BigInt
// de centavos de GYD antes de tocar el libro. Ningún monto sale de aritmética
// en punto flotante. Documentado en el contrato del ledger junto a la
// conversión de cobros.
//
// La tabla es de SOLO INSERCIÓN: cada cambio de precio es un INSERT nuevo
// con autor y fecha. El precio vigente de (cajero, servicio) es la fila más
// nueva por vigenteDesde. El precio se congela en cada operación (ya no como
// `tasaAplicada` compuesta, sino como el precio GYD/USD que se le aplicó),
// igual que antes: cambiar el precio de un cajero nunca altera una operación
// registrada. El historial es consultable porque el precio determina deudas
// pasadas.

model PrecioCajeroServicio {
  id           String       @id @default(uuid())
  cajeroId     String // → PerfilCajero.usuarioId
  cajero       PerfilCajero @relation(fields: [cajeroId], references: [usuarioId])
  servicioId   String // → Corredor.id (el servicio: país + producto)
  servicio     Corredor     @relation(fields: [servicioId], references: [id])
  precioGyd    Decimal      @db.Decimal(18, 6) // GYD por 1 USD. Ratio, no monto.
  vigenteDesde DateTime     @default(now())
  fijadoPorId  String // el admin

  @@unique([cajeroId, servicioId, vigenteDesde])
  @@index([cajeroId, servicioId, vigenteDesde])
  @@index([servicioId])
}

// ─────────────────────────────── OPERACIONES ───────────────────────────────

enum EstadoOperacion {
  en_verificacion
  en_proceso
  completada
  observada
  rechazada
  anulada
  pendiente // Fase 9: en la cola del pagador del país destino
  pagada // Fase 9: el pagador la ejecutó y descontó la caja
}

model Operacion {
  id         String       @id @default(uuid())
  folio      String       @unique // "TAV-2482"
  clientUuid String       @unique // idempotencia
  cajeroId   String
  cajero     PerfilCajero @relation(fields: [cajeroId], references: [usuarioId])

  tipo              String // "usdt_bs" | "usd_efectivo_bs"
  montoOrigenCents  BigInt // en la moneda de origen (USDT, USD, ...) — lo que el cajero envía
  monedaOrigen      String // "USDT" | "USD" — moneda que envía el cajero
  tasaAplicada      Decimal @db.Decimal(18, 6) // precio congelado en el registro (GYD por 1 USD)
  totalCents        BigInt // deuda en GYD centavos, calculada por el servidor = round(montoOrigenCents × tasaAplicada)
  montoDestinoCents BigInt // en la moneda de destino (BS, BRL, ...) — lo registra el pagador al ejecutar; 0 al crear
  monedaDestino     String // "BS" — moneda que recibe el beneficiario (derivada del servicio)

  // Precio de compra del USDT congelado al registrar la operación: el del
  // ingreso a la caja madre más reciente hasta la fecha de la operación.
  // Nullable: si no hay ningún ingreso antes de la operación, va null y el
  // reporte de ganancia muestra esa operación sin margen (no se inventa un
  // número). Es el marcador del día del que hablan los cajeros.
  precioCompraGyd   Decimal? @db.Decimal(18, 6) // GYD por 1 USD

  beneficiario   Json // {nombre, documento, banco, cuenta, metodo}
  estado         EstadoOperacion @default(pendiente)
  comprobanteUrl String?

  ampliacionId String?            @unique // si consumió una ampliación
  ampliacion   AmpliacionCredito? @relation(fields: [ampliacionId], references: [id])

  creadaPorId     String // el cajero, o el admin si la registró por él
  creadaAt        DateTime  @default(now())
  anuladaAt       DateTime?
  anuladaPorId    String?
  motivoAnulacion String?

  // Fase 9 (Bloque 2): el destino de la operación. Nullable porque las
  // operaciones anteriores a Fase 9 no lo tienen; sin él no puede pagarse
  // por caja (ejecutarPago valida caja.corredorId === operacion.corredorId).
  corredorId String?
  corredor   Corredor? @relation(fields: [corredorId], references: [id])

  // Fase 9 (Bloque 2): datos que registra el pagador al ejecutar el pago.
  // Van null hasta que la operación pasa a estado `pagada`.
  pagadaAt      DateTime?
  tasaEjecucion Decimal?  @db.Decimal(18, 6) // a cómo se ejecutó de verdad el cambio; se congela
  formaPago     String? // "pago_movil" | "transferencia" | "efectivo" | ...
  nombreCliente String? // el cliente que recibió
  pagadaPorId   String? // el pagador
  comprobantePagoUrl String? // captura del pago subida por el pagador (endpoint autenticado)

  @@index([cajeroId, creadaAt])
  @@index([estado])
}

// ─────────────────────────────── COBROS ───────────────────────────────

// El cajero siempre paga en guyaneses. La distinción que importa ya no es
// la moneda sino si el cobrador carga billetes o no.
enum MetodoCobro {
  efectivo_gyd
  transferencia_gyd
}

model Cobro {
  id         String @id @default(uuid())
  folio      String @unique // "COB-0412"
  clientUuid String @unique // idempotencia — CRÍTICO para el modo offline

  cajeroId   String
  cajero     PerfilCajero    @relation(fields: [cajeroId], references: [usuarioId])
  cobradorId String? // null si lo registró el admin
  cobrador   PerfilCobrador? @relation(fields: [cobradorId], references: [usuarioId])

  metodo     MetodoCobro
  montoCents BigInt // en GYD — el cajero siempre paga en guyaneses
  esEfectivo Boolean // true solo para efectivo_gyd → suma al cuadre físico

  cierreId String?
  cierre   Cierre? @relation(fields: [cierreId], references: [id])

  comprobanteUrl String?
  nota           String?

  creadoAt        DateTime  @default(now())
  sincronizadoAt  DateTime? // null mientras vive solo en el teléfono
  anuladoAt       DateTime?
  anuladoPorId    String?
  motivoAnulacion String?

  @@index([cobradorId, creadoAt])
  @@index([cajeroId, creadoAt])
  @@index([cierreId])
}

// ────────────────────── LIBRO CONTABLE (APPEND-ONLY) ──────────────────────

enum TipoMovimiento {
  cargo // una operación: sube la deuda
  abono // un cobro: baja la deuda
  reverso_cargo // anulación de operación
  reverso_abono // anulación de cobro
  ajuste // corrección manual del admin, siempre con motivo
}

/// NUNCA se hace UPDATE ni DELETE sobre esta tabla.
/// Corregir = insertar un movimiento de reverso.
model Movimiento {
  id       String       @id @default(uuid())
  seq      BigInt       @default(autoincrement())
  cajeroId String
  cajero   PerfilCajero @relation(fields: [cajeroId], references: [usuarioId])

  tipo         TipoMovimiento
  montoCents   BigInt // en la moneda base (GYD). positivo sube deuda, negativo la baja
  saldoDespues BigInt // foto del saldo tras aplicar este movimiento

  origenTipo      String // "operacion" | "cobro" | "ajuste"
  origenId        String
  motivo          String? // obligatorio en reversos y ajustes
  registradoPorId String
  creadoAt        DateTime @default(now())

  @@index([cajeroId, seq])
  @@index([cajeroId, creadoAt])
  @@index([origenTipo, origenId])
}

// ─────────────────────────── AMPLIACIÓN DE CUPO ───────────────────────────

enum EstadoAmpliacion {
  pendiente
  aprobada
  rechazada
  consumida
  expirada
}

model AmpliacionCredito {
  id       String       @id @default(uuid())
  cajeroId String
  cajero   PerfilCajero @relation(fields: [cajeroId], references: [usuarioId])

  montoCents BigInt // cupo extra solicitado
  motivo     String
  estado     EstadoAmpliacion @default(pendiente)

  solicitadaAt  DateTime  @default(now())
  resueltaAt    DateTime?
  resueltaPorId String?
  notaAdmin     String?

  operacion Operacion? // la operación que la consumió

  @@index([cajeroId, estado])
  @@index([estado])
}

// ─────────────────────────── CIERRE DIARIO ───────────────────────────

enum EstadoCierre {
  abierto
  enviado
  verificado
  con_diferencia
}

model Cierre {
  id         String         @id @default(uuid())
  cobradorId String
  cobrador   PerfilCobrador @relation(fields: [cobradorId], references: [usuarioId])
  fecha      DateTime       @db.Date

  totalRegistradoCents BigInt @default(0) // en GYD (contabilidad)
  digitalCents         BigInt @default(0) // en GYD

  // Efectivo físico declarado por el cobrador. El cajero siempre paga en
  // guyaneses: hay una sola pila de billetes que el admin cuenta.
  efectivoDeclaradoCents BigInt @default(0) // en GYD cents

  estado       EstadoCierre @default(abierto)
  entregadoA   String?
  notaCobrador String?

  enviadoAt       DateTime?
  verificadoAt    DateTime?
  verificadoPorId String?

  // Efectivo físico contado por el admin.
  efectivoRecibidoCents BigInt? // en GYD cents

  // Diferencia: recibido − declarado.
  diferenciaCents BigInt? // en GYD cents

  notaAdmin String?

  cobros Cobro[]

  @@unique([cobradorId, fecha])
  @@index([estado])
}

// ─────────────────────── ATENCIÓN Y AVISOS ───────────────────────

/// "Lo estoy atendiendo" — evita que dos cobradores vayan al mismo cajero.
model Atencion {
  id         String         @id @default(uuid())
  cajeroId   String
  cajero     PerfilCajero   @relation(fields: [cajeroId], references: [usuarioId])
  cobradorId String
  cobrador   PerfilCobrador @relation(fields: [cobradorId], references: [usuarioId])
  iniciadaAt DateTime       @default(now())
  liberadaAt DateTime?

  @@index([cajeroId, liberadaAt])
}

enum TipoAviso {
  cobro_automatico
  cobro_manual
  cerca_del_limite
  sin_cupo
  vencido
  ampliacion_resuelta
}

model Aviso {
  id           String       @id @default(uuid())
  cajeroId     String
  cajero       PerfilCajero @relation(fields: [cajeroId], references: [usuarioId])
  tipo         TipoAviso
  titulo       String
  cuerpo       String
  enviadoAt    DateTime     @default(now())
  leidoAt      DateTime? // el admin necesita saber si lo leyó
  enviadoPorId String? // null si lo generó el sistema

  @@index([cajeroId, leidoAt])
}

// ─────────────────────────── AUDITORÍA ───────────────────────────

model AuditLog {
  id        String   @id @default(uuid())
  actorId   String
  accion    String // "cobro.anular", "credito.ampliar", ...
  entidad   String
  entidadId String
  antes     Json?
  despues   Json?
  ip        String?
  creadoAt  DateTime @default(now())

  @@index([entidad, entidadId])
  @@index([actorId, creadoAt])
}

// ─────────────────────────── CONFIGURACIÓN ───────────────────────────

/// Umbrales y parámetros que el cliente puede cambiar sin tocar código.
model Config {
  clave String @id // "semaforo.dias_ambar" = "4", "semaforo.pct_ambar" = "0.75", ...
  valor String
}

// ─────────────────────────── CORREDORES (Fase 9) ───────────────────────────

/// Un corredor es un SERVICIO: lo que se vende y se cotiza (país + producto).
/// Venezuela tiene tres (BCV, tasa especial y USD en efectivo) con precios
/// distintos; modelarlo como par de monedas no cabe y tocaría migrar.
///
/// La unicidad es `pais + servicio` (no `pais + moneda + formaEntrega` como
/// antes): BCV y tasa especial comparten país, moneda y forma de entrega, pero
/// son servicios distintos. El índice único parcial (solo activos) se crea en
/// la migración SQL: `CREATE UNIQUE INDEX ... WHERE "activo" = true`.
///
/// La lista NO se quema en el código: el admin puede añadir servicios desde
/// el panel. Uno desactivado desaparece de la app del cajero pero conserva
/// su historia (las operaciones lo siguen referenciando).
///
/// `cajaId` apunta a la caja FÍSICA de la que descuenta este servicio. Varios
/// servicios pueden apuntar a la misma caja (BCV y tasa especial → misma caja
/// de bolívares en cuenta). La caja madre nunca es destino: `esMadre = true`
/// queda fuera. La moneda del servicio debe coincidir con la de su caja
/// (validación en CorredorService, no en BD).
model Corredor {
  id                 String   @id @default(uuid())
  pais               String // código ISO-3: "VEN", "BRA", "COL", ...
  paisNombre         String // "Venezuela", "Brasil" — para mostrar en UI
  moneda             String // código ISO-4217: "BS", "USD", "BRL", "COP", "DOP", "MXN"
  monedaNombre       String // "Bolívares", "Dólares" — para mostrar
  formaEntrega       String // "transferencia" | "efectivo" | "pago_movil" | ...
  formaEntregaNombre String // etiqueta legible para la UI
  servicio           String // "bcv" | "tasa_especial" | "efectivo" | "pix" | ... — el producto
  servicioNombre     String // "BCV", "Tasa especial", "Efectivo en mano" — etiqueta legible
  cajaId             String // → Caja.id (la caja física de la que descuenta)
  caja               Caja    @relation(fields: [cajaId], references: [id])
  activo             Boolean  @default(true)
  creadoAt           DateTime @default(now())
  creadoPorId        String
  desactivadoAt      DateTime? // auditable: cuándo se desactivó
  desactivadoPorId   String? // auditable: quién lo desactivó

  precios PrecioCajeroServicio[]
  operaciones Operacion[]

  @@index([pais, activo])
  @@index([activo])
  @@index([cajaId])
}

// ─────────────────────────── TESORERÍA: CAJAS (Fase 9) ───────────────────────────

/// Una caja responde: ¿dónde está la plata y cuánta queda?
///
/// La caja es FÍSICA: dónde está el dinero, no qué servicio lo usa. Varios
/// servicios pueden descontar de la misma caja (BCV y tasa especial comparten
/// la caja de bolívares en cuenta). La caja no cuelga de un corredor: el
/// vínculo va al revés, `Corredor.cajaId` → `Caja`.
///
/// Además existen cajas MADRE (la primera es USDT): no tienen servicios
/// asociados y se llenan cuando entra USDT al negocio. Las cajas de servicio
/// se llenan convirtiendo desde una caja madre (doble entrada: débito de la
/// madre + crédito de la destino, en la misma transacción).
///
/// `nombre` identifica la caja en el panel y en las alertas (la caja ya no
/// tiene corredor del que derivar la descripción). `pais` es opcional: la
/// caja madre USDT no tiene país.
///
/// saldoCents es un CACHE, igual que PerfilCajero.saldoCents: solo se escribe
/// dentro de la transacción que inserta el movimiento. El saldo real es la
/// suma de MovimientoCaja. db:verify lo comprueba.
///
/// Montos en centavos de la MONEDA DE LA CAJA (no siempre GYD): Bs, BRL, USDT...
model Caja {
  id        String   @id @default(uuid())
  esMadre   Boolean  @default(false)
  moneda    String // "USDT", "BS", "BRL", ... — denota la unidad de saldoCents
  nombre    String // "Bolívares en cuenta", "Caja madre USDT" — para UI y alertas
  pais      String? // "VEN", "BRA", ... — null para la caja madre
  saldoCents        BigInt  @default(0) // CACHE. Centavos de `moneda`.
  umbralAlertaCents BigInt? // saldo <= umbral → alerta "saldo bajo" (distinta de negativo)
  creadaAt          DateTime @default(now())

  movimientos MovimientoCaja[]
  servicios   Corredor[] // los servicios que descuentan de esta caja

  @@index([esMadre])
  @@index([moneda])
}

/// Libro de cajas. Append-only, igual que Movimiento.
/// NUNCA UPDATE ni DELETE. Corregir = insertar un reverso.
enum TipoMovimientoCaja {
  apertura // admin convierte USDT → moneda del corredor; sube saldo (crédito destino)
  recarga // otra conversión desde USDT; sube saldo
  ingreso // entra USDT (o efectivo) al negocio; sube saldo de la caja MADRE
  transferencia // débito de la caja MADRE hacia una caja de corredor (contrapartida de apertura/recarga)
  pago // el pagador ejecuta una operación; baja saldo de la caja del corredor
  reverso_apertura // anulación de apertura/recarga (reversa crédito destino + débito madre)
  reverso_pago // anulación de un pago ya ejecutado
  ajuste // corrección manual del admin, siempre con motivo
}

model MovimientoCaja {
  id     String @id @default(uuid())
  seq    BigInt @default(autoincrement())
  cajaId String
  caja   Caja   @relation(fields: [cajaId], references: [id])

  tipo         TipoMovimientoCaja
  montoCents   BigInt // + sube, − baja. Centavos de la MONEDA DE LA CAJA.
  saldoDespues BigInt // foto del saldo tras este movimiento

  // Solo para apertura/recarga: la conversión interna desde la caja madre.
  // En `ingreso` y `pago` van null (no hay conversión).
  cajaMadreId     String? // caja de la que salió el USDT (para doble entrada)
  montoMadreCents BigInt? // cuánto salió de la caja madre (en la moneda de la madre)
  tasaConversion  Decimal? @db.Decimal(18, 6) // tasa madre → moneda del corredor usada. Mismo tipo que tasaAplicada.

  // Solo para `ingreso` a la caja madre: el precio al que se compró el USDT
  // en ese ingreso (GYD por 1 USD). Es el marcador del día del que hablan los
  // cajeros. Cada operación congela el precio de compra vigente (el del
  // ingreso más reciente hasta la fecha de la operación), o null si no hay
  // ningún ingreso antes. En `apertura`, `recarga`, `pago` y `ajuste` va null.
  precioCompraGyd Decimal? @db.Decimal(18, 6)

  origenTipo      String // "apertura" | "recarga" | "ingreso" | "pago" | "ajuste"
  origenId        String // operacionId cuando es un pago
  clientUuid      String // IDEMPOTENCIA — único POR CAJA (ver @@unique abajo):
  // las dos patas de una apertura comparten el mismo uuid.
  motivo          String? // obligatorio en reversos y ajustes
  registradoPorId String
  creadoAt        DateTime @default(now())

  @@unique([cajaId, clientUuid])
  @@index([cajaId, seq])
  @@index([cajaId, creadoAt])
  @@index([origenTipo, origenId])
}
