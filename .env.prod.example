# TAV — Variables de entorno de producción.
#
# ADVERTENCIA: NUNCA commitea el archivo .env.prod real.
# Este archivo (.env.prod.example) es una plantilla sin secretos.
# El .env.prod real se crea en el servidor y se mantiene fuera de git.
#
# Genera secretos fuertes con:
#   openssl rand -base64 32
#
# Copia este archivo y rellena los valores:
#   cp .env.prod.example .env.prod

# ── Base de datos ──
# Contraseña del usuario postgres. Genera con: openssl rand -base64 32
POSTGRES_PASSWORD=

# URL de conexión. Usa el nombre del servicio 'db' dentro de Docker.
# La contraseña debe coincidir con POSTGRES_PASSWORD.
DATABASE_URL=postgresql://tav:TU_PASSWORD_AQUI@db:5432/tav?schema=public

# ── JWT ──
# Secreto para firmar tokens. Genera con: openssl rand -base64 32
JWT_SECRET=

# Duración del access token. Formato de ms: "15m", "30m", "1h".
JWT_EXPIRES_IN=15m

# Duración del refresh token. Formato de ms: "30d", "7d".
JWT_REFRESH_EXPIRES_IN=30d

# ── Entorno ──
NODE_ENV=production

# ── CORS ──
# Dominio del panel admin. Solo este origen puede llamar a la API.
# Sin slash final. Ej: https://admin.tudominio.com
CORS_ORIGIN=
